#!/bin/bash
# =============================================================================
# NetworkUSB client postinstall — выполняется от root внутри Installer.app.
#
# Порядок:
#   0. PREFLIGHT — проверка зависимостей компьютера. Любой [FAIL] -> отмена
#      установки (installer покажет "Installation Failed", лог сохраняется).
#   1. Установка недостающего (Tailscale, uv) — уже установленное пропускаем.
#   2. Tailnet join по одноразовому auth key (машина появляется у мастера).
#   3. Python (uv managed) + venv + установка NetworkUSB.
#   4. Секрет /etc/networkusb/token (генерируется НА МЕСТЕ, в пакете нет).
#   5. LaunchDaemon com.usbmuxd.agent + запуск.
#
# Плейсхолдеры __TS_AUTHKEY__ / __TS_HOSTNAME__ подставляет build_client_pkg.sh.
# =============================================================================
set -uo pipefail

PAYLOAD=/opt/networkusb
LOG=/var/log/networkusb-install.log
TS_AUTHKEY="__TS_AUTHKEY__"
TS_HOSTNAME="__TS_HOSTNAME__"
FAILED=0

log() { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOG"; }

{
echo "======================================================"
echo "NetworkUSB client install — $(date)"
echo "======================================================"
} >> "$LOG"

# --- 0. PREFLIGHT: зависимости -------------------------------------------------
log "PREFLIGHT: проверка зависимостей компьютера"

run_check() { # run_check <имя> <сообщение_при_ошибке> <bash-код проверки>
    local name="$1" msg="$2" code="$3"
    if bash -c "$code"; then
        log "  [OK]   $name"
    else
        log "  [FAIL] $name — $msg"
        FAILED=1
    fi
}

run_warn_check() { # run_warn_check <имя> <сообщение_при_предупреждении> <bash-код проверки>
    local name="$1" msg="$2" code="$3"
    if bash -c "$code"; then
        log "  [OK]   $name"
    else
        log "  [WARN] $name — $msg"
    fi
}

run_check "macOS 13+ (Ventura)"        "слишком старая macOS" \
    '[[ $(sw_vers -productVersion | cut -d. -f1) -ge 13 ]]'
run_check "Архитектура arm64/x86_64"   "неподдерживаемая архитектура" \
    '[[ "$(uname -m)" =~ ^(arm64|x86_64)$ ]]'
run_check "Свободное место (>= 2 ГБ)"  "освободи место на диске" \
    '[[ $(df -k / | awk "NR==2{print \$4}") -ge 2097152 ]]'
run_check "Интернет (pypi.org)"        "нужен доступ в интернет" \
    'curl -fsS --max-time 10 -o /dev/null https://pypi.org/pypi/typer/json'
run_check "usbmuxd запущен (/var/run/usbmuxd)" "сервис usbmuxd не запущен" \
    'test -S /var/run/usbmuxd'
run_warn_check "iPhone по USB (ioreg)"  "iPhone пока не подключен (можно подключить после установки)" \
    'ioreg -p IOUSB -l 2>/dev/null | grep -qi iphone'

if [ "$FAILED" != 0 ]; then
    log ""
    log "======================================================"
    log "УСТАНОВКА ПРЕРВАНА — не пройдены проверки зависимостей."
    log "Исправь отмеченные [FAIL] пункты и запусти инсталлер снова."
    log "Лог: $LOG"
    log "======================================================"
    exit 1
fi
log "PREFLIGHT: все проверки пройдены — продолжаем установку"

# --- 1. Tailscale: headless tailscaled (userspace, без GUI) --------------------
TS_BIN=/usr/local/bin/tailscaled
TS_CLI=/usr/local/bin/tailscale
TS_SOCK=/var/run/tailscale/tailscaled.sock
TS_STATE=/var/lib/tailscale/tailscaled.state
TS_IP=""
ARCH="$(uname -m)"; [ "$ARCH" = "x86_64" ] && TS_ARCH=amd64 || TS_ARCH=arm64
TS_SRC="$PAYLOAD/installer/tailscaled/$TS_ARCH"

if [ ! -x "$TS_BIN" ]; then
    if [ -x "$TS_SRC/tailscaled" ]; then
        log "Установка headless tailscaled ($TS_ARCH)..."
        cp "$TS_SRC/tailscaled" "$TS_BIN" && chmod 755 "$TS_BIN"
        cp "$TS_SRC/tailscale"  "$TS_CLI" && chmod 755 "$TS_CLI"
    fi
fi
if [ ! -x "$TS_BIN" ]; then
    log "ERROR: tailscaled не установлен"; FAILED=1
else
    log "tailscaled: $("$TS_BIN" --version | head -1)"
    mkdir -p /var/lib/tailscale /var/run/tailscale
    chmod 700 /var/lib/tailscale
    # LaunchDaemon: userspace-networking — БЕЗ Network Extension, значит без
    # GUI-запроса «VPN-конфигурация» и без онбординга (полная тишина).
    cat > /Library/LaunchDaemons/com.tailscale.headless.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tailscale.headless</string>
    <key>ProgramArguments</key>
    <array>
        <string>$TS_BIN</string>
        <string>--tun=userspace-networking</string>
        <string>--state=$TS_STATE</string>
        <string>--socket=$TS_SOCK</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/var/log/tailscaled.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/tailscaled.log</string>
</dict>
</plist>
PLIST
    chown root:wheel /Library/LaunchDaemons/com.tailscale.headless.plist
    chmod 644 /Library/LaunchDaemons/com.tailscale.headless.plist
    launchctl bootout system/com.tailscale.headless 2>/dev/null || true
    sleep 1
    launchctl bootstrap system /Library/LaunchDaemons/com.tailscale.headless.plist 2>&1 | tee -a "$LOG" || true
    for i in $(seq 1 60); do [ -S "$TS_SOCK" ] && break; sleep 1; done
    [ -S "$TS_SOCK" ] && log "tailscaled сокет: OK" || { log "ERROR: tailscaled сокет не появился"; FAILED=1; }
fi

# --- 2. Подключение к tailnet (одноразовый auth key, headless) -----------------
if [ -x "$TS_CLI" ] && [ -S "$TS_SOCK" ]; then
    if "$TS_CLI" --socket="$TS_SOCK" status >/dev/null 2>&1; then
        log "Tailscale уже в сети"
    else
        log "Подключение к tailnet по auth key..."
        "$TS_CLI" --socket="$TS_SOCK" up --authkey="$TS_AUTHKEY" \
            ${TS_HOSTNAME:+--hostname="$TS_HOSTNAME"} >/dev/null 2>&1 &
        UP_PID=$!
        ( sleep 90; kill "$UP_PID" 2>/dev/null ) &
        KILLER_PID=$!
        wait "$UP_PID" 2>/dev/null
        kill "$KILLER_PID" 2>/dev/null
    fi
    for i in $(seq 1 120); do
        TS_IP=$("$TS_CLI" --socket="$TS_SOCK" ip -4 2>/dev/null | head -1)
        [ -n "$TS_IP" ] && break
        sleep 1
    done
    log "Tailscale IP: ${TS_IP:-НЕ ПОЛУЧЕН}"
    [ -n "$TS_IP" ] || { log "ERROR: машина не получила tailnet IP"; FAILED=1; }
fi

# --- 3. uv + Python + venv + пакет ----------------------------------------------
UV_BIN=/usr/local/bin/uv
if [ ! -x "$UV_BIN" ]; then
    # uv использует aarch64/x86_64, а не arm64/amd64 как tailscaled
    case "$(uname -m)" in
        arm64)  UV_ARCH=aarch64 ;;
        x86_64) UV_ARCH=x86_64 ;;
        *)      UV_ARCH="$(uname -m)" ;;
    esac
    UV_TGZ="$PAYLOAD/installer/uv-$UV_ARCH-apple-darwin.tar.gz"
    if [ -f "$UV_TGZ" ]; then
        log "Установка uv ($ARCH)..."
        rm -rf /tmp/uv-install && mkdir -p /tmp/uv-install
        tar -xzf "$UV_TGZ" -C /tmp/uv-install
        UV_BIN_SRC="$(find /tmp/uv-install -name uv -type f | head -1)"
        [ -n "$UV_BIN_SRC" ] && cp "$UV_BIN_SRC" "$UV_BIN" && chmod 755 "$UV_BIN"
    fi
fi
if [ -x "$UV_BIN" ]; then
    log "uv: $("$UV_BIN" --version)"
else
    log "ERROR: uv не установлен"; FAILED=1
fi

if [ -x "$UV_BIN" ]; then
    cd "$PAYLOAD"
    if [ ! -x .venv/bin/python ]; then
        log "Установка Python 3.14 (uv managed)..."
        "$UV_BIN" python install 3.14 2>&1 | tee -a "$LOG" || log "WARN: uv python install не удался"
        log "Создание venv..."
        "$UV_BIN" venv .venv --python 3.14 2>&1 | tee -a "$LOG" || FAILED=1
    fi
    if [ -x .venv/bin/python ]; then
        log "Установка NetworkUSB в venv..."
        "$UV_BIN" pip install --python .venv/bin/python -e . 2>&1 | tee -a "$LOG"
        [ -x .venv/bin/usbmuxd-agent ] && log "agent binary: OK" \
            || { log "ERROR: usbmuxd-agent не собран"; FAILED=1; }
    else
        log "ERROR: venv не создан"; FAILED=1
    fi
fi

# --- 4. Секрет и сертификаты (генерируются на месте) ----------------------------
mkdir -p /etc/networkusb
if [ ! -s /etc/networkusb/token ]; then
    log "Генерация общего секрета (32 байта)..."
    umask 077
    openssl rand -hex 32 > /etc/networkusb/token
fi
chown root:wheel /etc/networkusb/token && chmod 600 /etc/networkusb/token
mkdir -p /etc/networkusb/certs
chown root:wheel /etc/networkusb/certs && chmod 700 /etc/networkusb/certs
test -s /etc/networkusb/token && log "Секрет: OK" || { log "ERROR: секрет не создан"; FAILED=1; }

# --- 5. LaunchDaemon ------------------------------------------------------------
AGENT_BIN="$PAYLOAD/.venv/bin/usbmuxd-agent"
cat > /Library/LaunchDaemons/com.usbmuxd.agent.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.usbmuxd.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>$AGENT_BIN</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8721</string>
        <string>--token-file</string>
        <string>/etc/networkusb/token</string>
        <string>--cert-dir</string>
        <string>/etc/networkusb/certs</string>
        <string>--log-level</string>
        <string>INFO</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
PLIST
chown root:wheel /Library/LaunchDaemons/com.usbmuxd.agent.plist
chmod 644 /Library/LaunchDaemons/com.usbmuxd.agent.plist

log "Перезапуск LaunchDaemon..."
launchctl bootout system/com.usbmuxd.agent 2>/dev/null || true
sleep 1
launchctl bootstrap system /Library/LaunchDaemons/com.usbmuxd.agent.plist 2>&1 | tee -a "$LOG" \
    || { log "ERROR: bootstrap не удался"; FAILED=1; }

# --- 6. Фаервол (best effort: разрешить python-бинарь) ---------------------------
FW=/usr/libexec/ApplicationFirewall/socketfilterfw
if [ -x "$FW" ] && [ -x "$PAYLOAD/.venv/bin/python" ]; then
    PYREAL="$("$PAYLOAD/.venv/bin/python" -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$PAYLOAD/.venv/bin/python" 2>/dev/null)"
    if [ -n "$PYREAL" ]; then
        "$FW" --add "$PYREAL"      >/dev/null 2>&1 || true
        "$FW" --unblockapp "$PYREAL" >/dev/null 2>&1 || true
    fi
fi

# --- 7. Проверка итога -----------------------------------------------------------
sleep 3
STATE="$(launchctl print system/com.usbmuxd.agent 2>/dev/null | awk '/state =/{print $3; exit}')"
LISTEN="$(lsof -nP -iTCP:8721 -sTCP:LISTEN 2>/dev/null | tail -n +2 | head -1)"
log "Агент state: ${STATE:-unknown}"
log "Listener :8721: ${LISTEN:-НЕ СЛУШАЕТ}"
[ "$STATE" = "running" ] || { log "ERROR: агент не в состоянии running"; FAILED=1; }

cat > /etc/networkusb/INSTALL_SUMMARY.txt <<EOF
NetworkUSB client install — $(date)
Tailscale IP: ${TS_IP:-N/A}
Hostname: $(hostname)
Agent state: ${STATE:-unknown}
Listener :8721: ${LISTEN:-none}
EOF
chmod 600 /etc/networkusb/INSTALL_SUMMARY.txt

# --- 8. Зачистка вложенных ассетов ------------------------------------------------
rm -rf "$PAYLOAD/installer" /tmp/uv-install

if [ "$FAILED" = 0 ]; then
    log ""
    log "======================================================"
    log "ГОТОВО. Машина в tailnet (IP: ${TS_IP}), агент слушает :8721."
    log "Скажи мастеру имя машины — он найдёт её в tailnet."
    log "======================================================"
    exit 0
else
    log ""
    log "======================================================"
    log "Установка завершилась с ошибками — см. лог: $LOG"
    log "======================================================"
    exit 1
fi
